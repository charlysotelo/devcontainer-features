{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "devcontainer-features",
      "changelog-path": "CHANGELOG.md"
    },
    "src/openpelo": {
      "release-type": "simple",
      "component": "openpelo",
      "changelog-path": "src/openpelo/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "src/openpelo/devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/talosctl": {
      "release-type": "simple",
      "component": "talosctl",
      "changelog-path": "src/talosctl/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "src/talosctl/devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/bitwarden-cli": {
      "release-type": "simple",
      "component": "bitwarden-cli",
      "changelog-path": "src/bitwarden-cli/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "src/bitwarden-cli/devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "src/atuin": {
      "release-type": "simple",
      "component": "atuin",
      "changelog-path": "src/atuin/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "src/atuin/devcontainer-feature.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
